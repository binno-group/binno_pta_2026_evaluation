ENV=development
HTTP_ADDR=:8080
HTTP_TIMEOUT=2s
SHUTDOWN_TIMEOUT=30s
SHUTDOWN_DRAIN_DELAY=5s
TRUSTED_PROXY_CIDRS=172.16.0.0/12
HTTP_MAX_IN_FLIGHT=0
HTTP_MAX_IN_FLIGHT_PER_CONN=4

OLTP_DATABASE_URL=postgres://binno:binno@localhost:5432/binno?sslmode=disable
OLTP_MAX_CONNS=20
ANALYTICS_DATABASE_URL=postgres://binno:binno@localhost:5433/binno_analytics?sslmode=disable
ANALYTICS_MAX_CONNS=10
ANALYTICS_TARGET=postgres
CLICKHOUSE_ENABLED=false
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DATABASE=analytics
DB_STATEMENT_TIMEOUT=1500ms

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

POSTGRES_PASSWORD=
GRAFANA_PASSWORD=
REDIS_TIMEOUT=500ms
REDIS_POOL_SIZE=32

JWT_SIGNING_KEY=change-me-in-every-environment

SMS_PROVIDER=log
SMS_TIMEOUT=1500ms

SMS_ESKIZ_BASE_URL=https://notify.eskiz.uz/api
SMS_ESKIZ_EMAIL=
SMS_ESKIZ_PASSWORD=
SMS_ESKIZ_FROM=

SMS_PLAYMOBILE_BASE_URL=
SMS_PLAYMOBILE_LOGIN=
SMS_PLAYMOBILE_PASSWORD=
SMS_PLAYMOBILE_ORIGINATOR=

OTLP_ENDPOINT=

METRICS_ADDR=:9090
DISPATCH_INTERVAL=500ms
DISPATCH_BATCH_SIZE=500
DISPATCH_MAX_ATTEMPTS=8
DISPATCH_RETRY_BASE=2s
DISPATCH_CLAIM_TTL=1m
OUTBOX_RETENTION=168h
OUTBOX_CLEANUP_BATCH=1000
OUTBOX_METRICS_INTERVAL=30s

ORDER_SWEEP_INTERVAL=1m
ORDER_SWEEP_BATCH=100
ORDER_SWEEP_EXPIRY_GRACE=2h

RATE_LIMIT_WINDOW=1m
RATE_LIMIT_AUTHENTICATED_BURST=300
RATE_LIMIT_ANONYMOUS_BURST=60

TEST_DB_URL=postgres://binno:binno@localhost:5432/binno?sslmode=disable
TEST_ANALYTICS_DB_URL=postgres://binno:binno@localhost:5433/binno_analytics?sslmode=disable
TEST_REDIS_ADDR=localhost:6379
TEST_CLICKHOUSE_URL=http://localhost:8123

OLTP_READ_DATABASE_URL=
OLTP_READ_MAX_CONNS=20
ANALYTICS_RETENTION=4320h

SEARCH_CACHE_TTL=0
